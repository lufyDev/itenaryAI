# Copy to .env and fill in. Never commit .env.

MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/itineraryai
JWT_SECRET=<long random string>
GOOGLE_CLIENT_ID=<google oauth client id>.apps.googleusercontent.com

# Public URL of the Next frontend. Used to build survey links.
FRONTEND_URL=https://itineraryai.in

# Base URL of the Python LangGraph service.
AI_SERVICE_URL=https://<agent-service-url>

# Comma-separated CORS allowlist for the API.
ALLOWED_ORIGINS=https://itineraryai.in,https://www.itineraryai.in

# Spend guardrails on /generate-stream (per hour). Optional — these are
# the defaults if unset.
GENERATE_LIMIT_PER_USER=3
GENERATE_LIMIT_GLOBAL=20
